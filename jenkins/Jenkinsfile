// Pipeline de la Parte 4 (Jenkins): copia una nueva version del sistema
// desde el folder donde esta el codigo fuente ya descargado (ORIGEN)
// hacia el folder donde luego sera testeado y desplegado (DESTINO).
//
// Posteriormente ejecuta:
//   - Despliegue de los servicios con la nueva version (docker compose)
//   - Suite completa de pruebas de integracion (test_apis.sh)
pipeline {
    agent any

    environment {
        ORIGEN        = '/origen'
        DESTINO       = '/destino'
        WORKSPACE_DIR = "${env.HOST_WORKSPACE ?: '/workspace'}"
    }

    stages {
        stage('Validar origen') {
            steps {
                sh '''
                    test -d "$ORIGEN" || { echo "No existe el folder de origen: $ORIGEN"; exit 1; }
                    test -n "$(ls -A "$ORIGEN" | grep -v '^.gitkeep$')" || { echo "El folder de origen esta vacio: $ORIGEN"; exit 1; }
                    test -d "$DESTINO" || mkdir -p "$DESTINO"
                    echo "Origen:  $ORIGEN"
                    echo "Destino: $DESTINO"
                '''
            }
        }

        stage('Copiar nueva version') {
            steps {
                sh '''
                    # Deja el destino limpio para que quede exactamente la nueva version
                    find "$DESTINO" -mindepth 1 -delete
                    cp -a "$ORIGEN"/. "$DESTINO"/
                '''
            }
        }

        stage('Verificar copia') {
            steps {
                sh '''
                    diff -rq "$ORIGEN" "$DESTINO" && echo "Copia verificada: origen y destino son identicos"
                    echo "Archivos copiados: $(find "$DESTINO" -type f | wc -l)"
                '''
            }
        }

        stage('Desplegar nueva version') {
            steps {
                sh '''
                    echo "== Desplegando el sistema con la nueva version =="
                    cd "$WORKSPACE_DIR" 2>/dev/null || cd /workspace

                    # Si el destino contiene docker-compose o archivos a actualizar, se sincronizan
                    if [ -f "$DESTINO/docker-compose.yml" ]; then
                        echo "Aplicando docker-compose desde destino..."
                        cp -a "$DESTINO"/. "$PWD"/
                    fi

                    # Reconstruye y levanta los servicios de la aplicacion (sin recrear Jenkins)
                    docker compose up -d --build productos ordenes procesamiento publicador web mosquitto
                    echo "Servicios desplegados correctamente."
                '''
            }
        }

        stage('Ejecutar pruebas') {
            steps {
                sh '''
                    echo "== Ejecutando suite de pruebas de integracion (test_apis.sh) =="
                    cd "$WORKSPACE_DIR" 2>/dev/null || cd /workspace

                    # Esperar activamente a que todos los microservicios esten listos
                    echo "Esperando que los microservicios esten respondiendo..."
                    for i in $(seq 1 30); do
                        if curl -s -f http://productos:5001/api/productos >/dev/null 2>&1 && \
                           curl -s -f http://ordenes:5002/api/ordenes >/dev/null 2>&1 && \
                           curl -s -f http://procesamiento:5003/api/facturas >/dev/null 2>&1 && \
                           curl -s -f http://publicador:5004/api/publicaciones >/dev/null 2>&1; then
                            echo "✓ Todos los microservicios estan listos."
                            break
                        fi
                        echo "Esperando inicio de servicios ($i/30)..."
                        sleep 2
                    done

                    # Ejecutar test_apis.sh apuntando a los microservicios en la red interna
                    BASE_URL_PRODUCTOS="http://productos:5001" \
                    BASE_URL_ORDENES="http://ordenes:5002" \
                    BASE_URL_PROCESAMIENTO="http://procesamiento:5003" \
                    BASE_URL_PUBLICADOR="http://publicador:5004" \
                    bash test_apis.sh
                '''
            }
        }
    }

    post {
        success { echo 'Pipeline completado exitosamente: version copiada, desplegada y todas las pruebas aprobadas.' }
        failure { echo 'El pipeline fallo: revisar el log de la etapa que presento error.' }
    }
}
